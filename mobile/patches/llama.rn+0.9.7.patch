\ No newline at end of file
+// Self-contained CJS replacement — avoids ESM/TypeScript loading issues in the
+// original lib/module build and the broken default-import in lib/commonjs build.
+'use strict';
+const { withAndroidManifest, createRunOncePlugin } = require('@expo/config-plugins');
+
+function withLlamaRnAndroid(config) {
+  return withAndroidManifest(config, (c) => {
+    const app = c.modResults.manifest.application?.[0];
+    if (!app) return c;
+    if (!app['uses-native-library']) app['uses-native-library'] = [];
+    const libs = app['uses-native-library'];
+    if (!libs.some(l => l.$['android:name'] === 'libOpenCL.so')) {
+      libs.push({ $: { 'android:name': 'libOpenCL.so', 'android:required': 'false' } });
+    }
+    if (!libs.some(l => l.$['android:name'] === 'libcdsprpc.so')) {
+      libs.push({ $: { 'android:name': 'libcdsprpc.so', 'android:required': 'false' } });
+    }
+    return c;
+  });
+}
+
+module.exports = createRunOncePlugin(withLlamaRnAndroid, 'llama-rn-plugin', '1.0.0');
