{
  "expo": {
    "name": "AI-MOG.IO",
    "slug": "ai-mog-io",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d1f3c",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1f3c"
    },
    "platforms": ["android"],
    "android": {
      "package": "io.aimog.influence",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1f3c"
      }
    },
    "scheme": "aimog",
    "plugins": [
      "expo-file-system"
    ],
    "extra": {
      "apiUrl": "https://ai-mog.io"
    }
  }
}
