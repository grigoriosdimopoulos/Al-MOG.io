# Required — Get a free key at https://console.groq.com
# Powers the AI ranking agent (Llama 3.3 70B, free tier: 7,500 req/day)
GROQ_API_KEY=gsk_your_key_here

# Optional — Enables real YouTube influencer data
# Get at: https://console.cloud.google.com (YouTube Data API v3, free: 10,000 units/day)
YOUTUBE_API_KEY=

# Optional — Enables real Twitter/X influencer data
# Get at: https://developer.twitter.com (Basic tier)
TWITTER_BEARER_TOKEN=

# Paid tier access — pass as X-Tier-Secret header to unlock PRO features
TIER_SECRET=change-this-to-a-strong-secret

# Database
DATABASE_URL=file:./dev.db
